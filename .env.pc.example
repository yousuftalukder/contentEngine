# The PC worker connects to the same database as the server, so it needs the same few values.
# Copy this file to .env.pc and fill each one from Render → contentengine-1 → Environment.
# .env.pc is ignored by git. Never paste these values into a chat.

DATABASE_URL=
# Decrypts keys stored in the dashboard's vault. Must be identical to the server's.
SECRETS_KEY=

# Only when files are kept in cloud storage (Settings → "Files are kept on your PC" switched off). While files are kept
# on this PC, Supabase Storage is not used and these can stay empty.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional. Where this PC keeps the files when they are kept on it. Default: data\media in the project folder.
# MEDIA_DIR=

# Optional. Without a key the PC's writing goes to the server's writer (LLM_RELAY), and Bangla transcription and scene
# watching are done on the server. A key here lets the PC do them itself. Keys stored on the dashboard's API keys page
# reach the PC anyway (through SECRETS_KEY); keys set only on Render do not.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
