# The PC worker connects to the same database and storage as the server, so it needs the same few values.
# Copy this file to .env.pc and fill each one from Render → contentengine-1 → Environment.
# .env.pc is ignored by git. Never paste these values into a chat.

DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Decrypts keys stored in the dashboard's vault. Must be identical to the server's.
SECRETS_KEY=

# Optional. The PC transcribes with whisper locally, so these matter only for hosted transcription or LLM picking.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
