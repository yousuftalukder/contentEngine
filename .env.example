# Content Engine — environment. Copy to .env for local runs (node --env-file=.env server.js); on Render set these in the
# "content-engine-shared" environment group. Provider keys can instead be pasted on the dashboard's API keys page.

# ---------------------------------------------------------------- required
# Supabase → Connect → Session pooler (port 5432)
DATABASE_URL=postgres://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=
# openssl rand -hex 32 — encrypts keys stored from the dashboard; never change it afterwards
SECRETS_KEY=
PUBLIC_BASE_URL=http://localhost:4000
# Media storage (bucket "media"). Required when the web service and the video worker are separate machines.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=media
# Writing, images, embeddings, Bangla TTS, transcription
GEMINI_API_KEY=

# ---------------------------------------------------------------- alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---------------------------------------------------------------- publishing (or per-channel keys in the dashboard)
META_ACCESS_TOKEN=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# ---------------------------------------------------------------- optional providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=
NEWSAPI_KEY=
YOUTUBE_API_KEY=

# ---------------------------------------------------------------- optional storage alternative: Cloudflare R2
# r2 | supabase | local (default: the first one configured)
STORAGE_BACKEND=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# ---------------------------------------------------------------- process roles and tuning
PORT=4000
# Unset = all lanes and sweeps in one process. Split setup — web: LANES=ingest,text,image,publish,metrics; worker: LANES=video, RUN_SWEEPS=0
# LANES=
# RUN_SWEEPS=
PG_POOL_MAX=8
# Studio render threads
REMOTION_CONCURRENCY=1
# Retries for rate limits, overloaded models and network errors (backoff up to about an hour)
TRANSIENT_MAX_ATTEMPTS=7

# ---------------------------------------------------------------- model overrides (defaults are sensible)
GEMINI_MODEL=gemini-flash-latest
GEMINI_FALLBACK_MODELS=gemini-flash-lite-latest
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
GEMINI_EMBED_MODEL=gemini-embedding-001
GEMINI_TTS_MODELS=gemini-2.5-flash-preview-tts,gemini-2.5-pro-preview-tts
GEMINI_TTS_VOICE=Kore
ANTHROPIC_MODEL=claude-sonnet-5
OPENAI_MODEL=gpt-4o-mini
# Font for photocards and burned-in captions (must be installed; the Docker image has Noto Sans Bengali)
OVERLAY_FONT=Noto Sans Bengali
# User agent for feed and article fetches
FEED_USER_AGENT=
